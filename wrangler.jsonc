{
  "topLevelName": "healthreachcare",
  "dev": {
    "ip": "localhost",
    "local_protocol": "http",
    "upstream_protocol": "http",
    "enable_containers": true,
    "generate_types": false
  },
  "name": "healthreachcare",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "FIREBASE_AUTH_ENABLED": "true",
    "FIREBASE_REGISTRATION_ENABLED": "true",
    "FIREBASE_GOOGLE_ENABLED": "true",
    "HRC_DEMO_ENABLED": "false",
    "FIREBASE_WEB_CONFIG": "{\"apiKey\":\"AIzaSyCj9NE4cPEumSfsp7JqONG0BJGY6SgvWJM\",\"authDomain\":\"gen-lang-client-0810450473.firebaseapp.com\",\"projectId\":\"gen-lang-client-0810450473\",\"storageBucket\":\"gen-lang-client-0810450473.firebasestorage.app\",\"messagingSenderId\":\"370128051283\",\"appId\":\"1:370128051283:web:20ae44f4dfc41d50abbaa6\"}"
  },
  "durable_objects": {
    "bindings": []
  },
  "kv_namespaces": [],
  "queues": {
    "producers": [],
    "consumers": []
  },
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "healthreachcare-documents"
    },
    {
      "binding": "DOCUMENTS_BUCKET",
      "bucket_name": "healthreachcare-documents"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "healthreachcare-app",
      "database_id": "aa78a384-cc38-4141-b550-fda0f34fb3a2"
    }
  ],
  "vectorize": [],
  "ai_search_namespaces": [],
  "ai_search": [],
  "hyperdrive": [],
  "workflows": [],
  "secrets_store_secrets": [],
  "artifacts": [],
  "services": [],
  "analytics_engine_datasets": [],
  "unsafe_hello_world": [],
  "flagship": [],
  "ratelimits": [],
  "worker_loaders": [],
  "legacy_env": true,
  "main": "replacement/healthreachcare/dist/server/index.js",
  "jsx_factory": "React.createElement",
  "jsx_fragment": "React.Fragment",
  "migrations": [],
  "triggers": {},
  "rules": [
    {
      "type": "ESModule",
      "globs": [
        "**/*.js",
        "**/*.mjs"
      ]
    }
  ],
  "build": {
    "watch_dir": "./src"
  },
  "no_bundle": true,
  "dispatch_namespaces": [],
  "logfwdr": {
    "bindings": []
  },
  "assets": {
    "directory": "replacement/healthreachcare/dist/client",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "python_modules": {
    "exclude": [
      "**/*.pyc"
    ]
  },
  "define": {},
  "cloudchamber": {},
  "send_email": [],
  "mtls_certificates": [],
  "pipelines": [],
  "vpc_services": [],
  "vpc_networks": [],
  "keep_vars": true
}
