rules_version = '2';
// HealthReachCare Firestore security rules.
// Paste into Firebase Console → Firestore Database → Rules → Publish.
// Mirrors the existing RLS model: users own their data, providers see only
// their own records, admins control approvals, nothing sensitive is public.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function owns(field) {
      return signedIn() && resource.data[field] == request.auth.uid;
    }
    function ownsNew(field) {
      return signedIn() && request.resource.data[field] == request.auth.uid;
    }
    function isBootstrapAdmin() {
      return signedIn()
        && request.auth.token.email is string
        && request.auth.token.email.lower() == 'admin@healthreachcare.co.za'
        && exists(/databases/$(database)/documents/user_roles/$(request.auth.uid + '_admin'))
        && get(/databases/$(database)/documents/user_roles/$(request.auth.uid + '_admin')).data.role == 'admin';
    }
    function isAdmin() {
      return isBootstrapAdmin() || hasRole('admin');
    }
    function hasRole(role) {
      return signedIn()
        && exists(/databases/$(database)/documents/user_roles/$(request.auth.uid + '_' + role))
        && get(/databases/$(database)/documents/user_roles/$(request.auth.uid + '_' + role)).data.role == role;
    }
    function userHasRole(userId, role) {
      return userId is string
        && exists(/databases/$(database)/documents/user_roles/$(userId + '_' + role))
        && get(/databases/$(database)/documents/user_roles/$(userId + '_' + role)).data.role == role;
    }
    function isHomecareProviderOwner(providerId) {
      return providerId is string
        && hasRole('homecare_company')
        && exists(/databases/$(database)/documents/homecare_providers/$(providerId))
        && get(/databases/$(database)/documents/homecare_providers/$(providerId)).data.user_id == request.auth.uid;
    }
    function isApprovedHomecareProviderOwner(providerId) {
      return isHomecareProviderOwner(providerId)
        && get(/databases/$(database)/documents/homecare_providers/$(providerId)).data.approval_status == 'approved'
        && get(/databases/$(database)/documents/homecare_providers/$(providerId)).data.is_active == true;
    }
    function isApprovedHomecareProvider(providerId) {
      return providerId is string
        && exists(/databases/$(database)/documents/homecare_providers/$(providerId))
        && get(/databases/$(database)/documents/homecare_providers/$(providerId)).data.approval_status == 'approved'
        && get(/databases/$(database)/documents/homecare_providers/$(providerId)).data.is_active == true
        && userHasRole(
          get(/databases/$(database)/documents/homecare_providers/$(providerId)).data.user_id,
          'homecare_company'
        );
    }
    function canReadHomecareAssignment(assignmentId) {
      return signedIn()
        && exists(/databases/$(database)/documents/homecare_assignments/$(assignmentId))
        && get(/databases/$(database)/documents/homecare_assignments/$(assignmentId)).data.request_id is string
        && exists(/databases/$(database)/documents/homecare_requests/$(get(/databases/$(database)/documents/homecare_assignments/$(assignmentId)).data.request_id))
        && (
          hasRole('patient')
            && get(/databases/$(database)/documents/homecare_requests/$(get(/databases/$(database)/documents/homecare_assignments/$(assignmentId)).data.request_id)).data.patient_id == request.auth.uid
          || isHomecareProviderOwner(get(/databases/$(database)/documents/homecare_assignments/$(assignmentId)).data.provider_id)
        );
    }
    function canSendHomecareMessage(assignmentId) {
      return canReadHomecareAssignment(assignmentId)
        && get(/databases/$(database)/documents/homecare_assignments/$(assignmentId)).data.status in ['accepted', 'scheduled', 'in_progress']
        && isApprovedHomecareProvider(get(/databases/$(database)/documents/homecare_assignments/$(assignmentId)).data.provider_id);
    }
    function homecareConversationMatches(assignmentId, conversation) {
      return conversation.assignment_id == assignmentId
        && exists(/databases/$(database)/documents/homecare_assignments/$(assignmentId))
        && conversation.request_id == get(/databases/$(database)/documents/homecare_assignments/$(assignmentId)).data.request_id
        && conversation.provider_id == get(/databases/$(database)/documents/homecare_assignments/$(assignmentId)).data.provider_id
        && exists(/databases/$(database)/documents/homecare_requests/$(conversation.request_id))
        && conversation.patient_id == get(/databases/$(database)/documents/homecare_requests/$(conversation.request_id)).data.patient_id;
    }
    function isApprovedPharmacy(pharmacyId) {
      return pharmacyId is string
        && exists(/databases/$(database)/documents/user_roles/$(pharmacyId + '_pharmacy'))
        && get(/databases/$(database)/documents/user_roles/$(pharmacyId + '_pharmacy')).data.role == 'pharmacy'
        && exists(/databases/$(database)/documents/profiles/$(pharmacyId))
        && get(/databases/$(database)/documents/profiles/$(pharmacyId)).data.approval_status == 'approved'
        && exists(/databases/$(database)/documents/pharmacies/$(pharmacyId))
        && get(/databases/$(database)/documents/pharmacies/$(pharmacyId)).data.status == 'approved';
    }
    function canReadOrder(order) {
      return isAdmin()
        || signedIn() && (
          order.patient_id == request.auth.uid
          || order.pharmacy_id == request.auth.uid && hasRole('pharmacy')
          || order.driver_id == request.auth.uid && hasRole('driver')
        );
    }
    function publishedMedication(medicationId, pharmacyId) {
      return exists(/databases/$(database)/documents/medications_public/$(medicationId))
        && get(/databases/$(database)/documents/medications_public/$(medicationId)).data.pharmacy_id == pharmacyId
        && get(/databases/$(database)/documents/medications_public/$(medicationId)).data.is_active == true
        && get(/databases/$(database)/documents/medications_public/$(medicationId)).data.is_demo == false
        && isApprovedPharmacy(pharmacyId)
        && exists(/databases/$(database)/documents/pharmacy_branches/$(get(/databases/$(database)/documents/medications_public/$(medicationId)).data.branch_id))
        && get(/databases/$(database)/documents/pharmacy_branches/$(get(/databases/$(database)/documents/medications_public/$(medicationId)).data.branch_id)).data.pharmacy_id == pharmacyId
        && get(/databases/$(database)/documents/pharmacy_branches/$(get(/databases/$(database)/documents/medications_public/$(medicationId)).data.branch_id)).data.is_primary == true
        && get(/databases/$(database)/documents/pharmacy_branches/$(get(/databases/$(database)/documents/medications_public/$(medicationId)).data.branch_id)).data.is_active == true;
    }
    function sourceMedicationHasStock(medicationId, pharmacyId, quantity, medicationName) {
      return exists(/databases/$(database)/documents/medications/$(medicationId))
        && get(/databases/$(database)/documents/medications/$(medicationId)).data.pharmacy_id == pharmacyId
        && get(/databases/$(database)/documents/medications/$(medicationId)).data.name == medicationName
        && get(/databases/$(database)/documents/medications/$(medicationId)).data.publish_requested == true
        && get(/databases/$(database)/documents/medications/$(medicationId)).data.is_active == true
        && get(/databases/$(database)/documents/medications/$(medicationId)).data.is_demo == false
        && get(/databases/$(database)/documents/medications/$(medicationId)).data.stock_quantity is int
        && get(/databases/$(database)/documents/medications/$(medicationId)).data.stock_quantity >= quantity;
    }
    function pharmacyOrderTransition(from, to) {
      return (from in ['pending', 'scheduled'] && to in ['accepted', 'cancelled'])
        || (from == 'accepted' && to in ['preparing', 'ready', 'cancelled'])
        || (from == 'preparing' && to in ['ready', 'cancelled']);
    }
    function driverOrderTransition(from, to) {
      return (from in ['accepted', 'preparing', 'ready'] && to == 'ready')
        || (from == 'ready' && to == 'out_for_delivery')
        || (from == 'out_for_delivery' && to == 'delivered')
        || (from in ['ready', 'out_for_delivery'] && to == 'cancelled');
    }
    function validOrderPrescription() {
      let medication = get(/databases/$(database)/documents/medications_public/$(request.resource.data.medication_id)).data;
      return medication.requires_prescription != true
        || request.resource.data.prescription_upload_id is string
          && exists(/databases/$(database)/documents/prescription_uploads/$(request.resource.data.prescription_upload_id))
          && get(/databases/$(database)/documents/prescription_uploads/$(request.resource.data.prescription_upload_id)).data.patient_id == request.auth.uid
          && get(/databases/$(database)/documents/prescription_uploads/$(request.resource.data.prescription_upload_id)).data.status == 'approved'
          && (
            !('medication_id' in get(/databases/$(database)/documents/prescription_uploads/$(request.resource.data.prescription_upload_id)).data)
            || get(/databases/$(database)/documents/prescription_uploads/$(request.resource.data.prescription_upload_id)).data.medication_id == request.resource.data.medication_id
          )
          && (
            get(/databases/$(database)/documents/prescription_uploads/$(request.resource.data.prescription_upload_id)).data.pharmacy_id == null
            || get(/databases/$(database)/documents/prescription_uploads/$(request.resource.data.prescription_upload_id)).data.pharmacy_id == request.resource.data.pharmacy_id
          );
    }
    function patientOrderUpdate() {
      return owns('patient_id')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'cancelled_at', 'cancelled_by', 'cancellation_reason',
          'updated_at', 'hidden_for_patient_at',
        ])
        && (
          request.resource.data.status == resource.data.status
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'cancelled_at', 'cancelled_by', 'cancellation_reason',
            ])
          || request.resource.data.status == 'cancelled'
            && resource.data.status in ['pending', 'scheduled', 'accepted', 'preparing', 'ready']
            && request.resource.data.cancelled_by == request.auth.uid
        );
    }
    function pharmacyOrderUpdate() {
      return owns('pharmacy_id')
        && hasRole('pharmacy')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updated_at'])
        && pharmacyOrderTransition(resource.data.status, request.resource.data.status);
    }
    function driverOrderUpdate() {
      return owns('driver_id')
        && hasRole('driver')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updated_at'])
        && driverOrderTransition(resource.data.status, request.resource.data.status);
    }
    function pharmacyMayHandlePrescription() {
      return owns('pharmacy_id')
        && hasRole('pharmacy')
        && resource.data.order_id is string
        && exists(/databases/$(database)/documents/orders/$(resource.data.order_id))
        && get(/databases/$(database)/documents/orders/$(resource.data.order_id)).data.patient_id == resource.data.patient_id
        && get(/databases/$(database)/documents/orders/$(resource.data.order_id)).data.pharmacy_id == request.auth.uid;
    }
    function validPatientIdentityNumber(data) {
      return !('id_number' in data)
        || data.id_number == null
        || data.id_number is string
          && (
            data.id_number.matches('^[0-9]{13}$')
            || data.id_number.matches('^[A-Za-z0-9]*[A-Za-z][A-Za-z0-9]{5,19}$')
          );
    }
    // Provider approval gate: only approved providers may operate.
    function isApproved(col, id) {
      return get(/databases/$(database)/documents/$(col)/$(id)).data.status == 'approved';
    }

    // Profiles: owner read/write; approved profiles support provider discovery.
    match /profiles/{uid} {
      allow read: if isOwner(uid) || owns('user_id') || isAdmin() || hasRole('homecare_operations')
        || signedIn() && resource.data.approval_status == 'approved';
      allow create: if isOwner(uid)
        && request.resource.data.user_id == request.auth.uid
        && (!('approval_status' in request.resource.data)
          || request.resource.data.approval_status in ['pending', 'under_review']);
      allow update: if isAdmin() || (isOwner(uid) || owns('user_id'))
        && request.resource.data.user_id == resource.data.user_id
        && (
          request.resource.data.approval_status == resource.data.approval_status
          || request.resource.data.approval_status == 'under_review'
            && resource.data.approval_status in ['pending', 'rejected']
        );
      allow delete: if isAdmin();
    }

    // Role self-registration is constrained to verified, eligible accounts.
    match /user_roles/{id} {
      allow read: if isAdmin() || owns('user_id')
        || signedIn() && resource.data.role == 'pharmacy';
      allow create: if isAdmin() || canRegisterRole(request.auth.uid, id);
      allow update, delete: if isAdmin();
    }

    // Identity documents and ID numbers are private to the patient and admins.
    // Patients may submit or replace data, but only admins may approve/reject it.
    match /patient_verifications/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
        && request.resource.data.user_id == uid
        && request.resource.data.status == 'pending'
        && validPatientIdentityNumber(request.resource.data)
        && request.resource.data.keys().hasOnly([
          'user_id', 'id_document_path', 'selfie_path', 'selfie_with_id_path',
          'id_number', 'status', 'updated_at',
        ]);
      allow update: if isAdmin()
          && (
            request.resource.data.status != 'approved'
            || request.resource.data.id_document_path is string
              && request.resource.data.selfie_path is string
              && request.resource.data.selfie_with_id_path is string
              && request.resource.data.id_number is string
              && (
                request.resource.data.id_number.matches('^[0-9]{13}$')
                || request.resource.data.id_number.matches('^[A-Za-z0-9]*[A-Za-z][A-Za-z0-9]{5,19}$')
              )
          )
        || isOwner(uid)
          && resource.data.user_id == uid
          && request.resource.data.user_id == uid
          && request.resource.data.status == 'pending'
          && validPatientIdentityNumber(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'id_document_path', 'selfie_path', 'selfie_with_id_path',
            'id_number', 'status', 'updated_at',
          ]);
      allow delete: if isAdmin();
    }

    // Provider profiles (doctors, pharmacies, drivers, homecare):
    // owner manages own record; admin reviews; approved records are
    // readable by signed-in users for the Find page.
    match /doctors/{id} {
      allow read: if signedIn() || isAdmin() || isOwner(id) || owns('user_id');
      allow create: if (isOwner(id) || ownsNew('user_id')) && request.resource.data.status == 'pending_review';
      allow update: if isAdmin() || ((isOwner(id) || owns('user_id')) && request.resource.data.status == resource.data.status);
      allow delete: if isAdmin();
    }
    match /pharmacies/{id} {
      allow read: if isAdmin() || isOwner(id) || owns('user_id') || (signedIn() && resource.data.status == 'approved');
      allow create: if ownsNew('user_id') && request.resource.data.status == 'pending_review';
      allow update: if isAdmin() || (owns('user_id') && request.resource.data.status == resource.data.status);
      allow delete: if isAdmin();
    }
    match /drivers/{id} {
      allow read: if isAdmin() || isOwner(id) || owns('user_id') || (signedIn() && resource.data.status == 'approved');
      allow create: if (isOwner(id) || ownsNew('user_id')) && request.resource.data.status == 'pending_review';
      allow update: if isAdmin() || ((isOwner(id) || owns('user_id')) && request.resource.data.status == resource.data.status);
      allow delete: if isAdmin();
    }
    match /homecare_providers/{id} {
      allow read: if isAdmin() || isOwner(id) || owns('user_id') || (signedIn() && (resource.data.approval_status == 'approved' || resource.data.status == 'approved'));
      allow create: if ownsNew('user_id')
        && request.resource.data.status == 'pending_review'
        && request.resource.data.approval_status in ['pending', 'pending_review']
        && (!('is_active' in request.resource.data) || request.resource.data.is_active == false);
      allow update: if isAdmin()
        || owns('user_id')
          && hasRole('homecare_company')
          && request.resource.data.user_id == resource.data.user_id
          && request.resource.data.status == resource.data.status
          && request.resource.data.approval_status == resource.data.approval_status
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'business_name', 'full_name', 'registration_number', 'contact_person',
            'phone', 'email', 'operating_hours', 'availability', 'pricing_notes',
            'hourly_rate', 'service_radius_km', 'qualifications', 'service_areas',
            'certifications', 'services', 'address', 'latitude', 'longitude',
            'is_active', 'updated_at',
          ])
          && (
            request.resource.data.get('is_active', false) == resource.data.get('is_active', false)
            || resource.data.approval_status == 'approved'
          );
      allow delete: if isAdmin();
    }
    match /homecare_staff/{id} {
      allow read: if isAdmin()
        || isHomecareProviderOwner(resource.data.company_id)
        || hasRole('homecare_staff') && owns('user_id');
      allow update, delete: if isAdmin() || isHomecareProviderOwner(resource.data.company_id);
      allow create: if isAdmin() || isHomecareProviderOwner(request.resource.data.company_id);
    }

    // Orders & bookings: customer owns; assigned provider reads; admin all.
    match /orders/{id} {
      allow read: if canReadOrder(resource.data);
      allow create: if ownsNew('patient_id')
        && request.resource.data.keys().hasAll([
          'patient_id', 'pharmacy_id', 'medication_id', 'medication_name', 'quantity', 'status',
        ])
        && request.resource.data.keys().hasOnly([
          'patient_id', 'pharmacy_id', 'medication_id', 'medication_name', 'quantity',
          'status', 'order_group_id', 'prescription_upload_id', 'delivery_fee', 'total_amount', 'delivery_km',
          'priority', 'scheduled_for', 'delivery_address', 'delivery_lat', 'delivery_lng',
          'pickup_lat', 'pickup_lng', 'assignment_radius_km', 'notes', 'recipient_name',
          'recipient_phone', 'recipient_family_member_id', 'created_at', 'updated_at', 'is_demo',
        ])
        && request.resource.data.medication_id is string
        && publishedMedication(request.resource.data.medication_id, request.resource.data.pharmacy_id)
        && sourceMedicationHasStock(
          request.resource.data.medication_id,
          request.resource.data.pharmacy_id,
          request.resource.data.quantity,
          request.resource.data.medication_name,
        )
        && request.resource.data.medication_name
          == get(/databases/$(database)/documents/medications_public/$(request.resource.data.medication_id)).data.name
        && request.resource.data.quantity is int
        && request.resource.data.quantity > 0
        && request.resource.data.quantity
          <= get(/databases/$(database)/documents/medications_public/$(request.resource.data.medication_id)).data.stock_quantity
        && request.resource.data.status in ['pending', 'scheduled']
        && validOrderPrescription()
        && (!('is_demo' in request.resource.data) || request.resource.data.is_demo == false);
      allow update: if isAdmin()
        || patientOrderUpdate()
        || pharmacyOrderUpdate()
        || driverOrderUpdate();
      allow delete: if isAdmin();
    }
    match /bookings/{id} {
      allow read: if isAdmin() || owns('patient_id') || owns('provider_id');
      allow create: if ownsNew('patient_id');
      allow update: if isAdmin() || owns('patient_id') || owns('provider_id');
      allow delete: if isAdmin();
    }

    // Payments: payer reads own; admin manages.
    match /payments/{id} {
      allow read: if isAdmin() || owns('patient_id') || owns('provider_id');
      allow create: if ownsNew('patient_id') && request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    // Home care requests & assignments: customer owns request; admin assigns;
    // assigned provider reads/updates their assignment only.
    match /homecare_requests/{id} {
      allow read: if isAdmin()
        || hasRole('homecare_operations')
        || hasRole('patient') && owns('patient_id')
        || resource.data.provider_id is string && isApprovedHomecareProviderOwner(resource.data.provider_id);
      allow create: if hasRole('patient')
        && ownsNew('patient_id')
        && request.resource.data.keys().hasOnly([
          'patient_id', 'service_type', 'description', 'address', 'latitude',
          'longitude', 'preferred_at', 'duration_hours', 'provider_id', 'status',
          'created_at', 'updated_at',
        ])
        && request.resource.data.status == 'pending_review'
        && request.resource.data.provider_id == null
        && request.resource.data.service_type is string
        && request.resource.data.service_type.size() >= 2
        && request.resource.data.service_type.size() <= 120
        && request.resource.data.address is string
        && request.resource.data.address.size() >= 5
        && request.resource.data.address.size() <= 500;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    match /homecare_assignments/{id} {
      allow read: if isAdmin() || canReadHomecareAssignment(id);
      allow create: if isAdmin();
      allow update: if isAdmin()
        || isApprovedHomecareProviderOwner(resource.data.provider_id)
          && request.resource.data.request_id == resource.data.request_id
          && request.resource.data.provider_id == resource.data.provider_id
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'accepted_at', 'declined_reason', 'completed_at', 'updated_at',
          ])
          && (
            resource.data.status == 'offered'
              && request.resource.data.status in ['accepted', 'declined']
            || resource.data.status == 'accepted' && request.resource.data.status == 'scheduled'
            || resource.data.status == 'scheduled' && request.resource.data.status == 'in_progress'
            || resource.data.status == 'in_progress' && request.resource.data.status == 'completed'
          )
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['accepted_at'])
            || request.resource.data.status == 'accepted')
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['declined_reason'])
            || request.resource.data.status == 'declined')
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['completed_at'])
            || request.resource.data.status == 'completed')
          && (request.resource.data.status != 'completed' || request.resource.data.completed_at is string);
      allow delete: if isAdmin();
    }
    match /homecare_conversations/{assignmentId} {
      allow read: if canReadHomecareAssignment(assignmentId)
        && (
          !exists(/databases/$(database)/documents/homecare_conversations/$(assignmentId))
          || homecareConversationMatches(assignmentId, resource.data)
        );
      allow create: if canSendHomecareMessage(assignmentId)
        && request.resource.data.keys().hasOnly([
          'assignment_id', 'request_id', 'patient_id', 'provider_id', 'status',
          'created_at', 'updated_at',
        ])
        && request.resource.data.keys().hasAll([
          'assignment_id', 'request_id', 'patient_id', 'provider_id', 'status',
        ])
        && request.resource.data.status == 'active'
        && homecareConversationMatches(assignmentId, request.resource.data);
      allow update, delete: if false;

      match /messages/{messageId} {
        allow read: if canReadHomecareAssignment(assignmentId)
          && exists(/databases/$(database)/documents/homecare_conversations/$(assignmentId))
          && homecareConversationMatches(
            assignmentId,
            get(/databases/$(database)/documents/homecare_conversations/$(assignmentId)).data
          );
        allow create: if canSendHomecareMessage(assignmentId)
          && request.resource.data.keys().hasOnly(['sender_id', 'body', 'created_at'])
          && request.resource.data.keys().hasAll(['sender_id', 'body', 'created_at'])
          && request.resource.data.sender_id == request.auth.uid
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 4000
          && request.resource.data.created_at is string
          && exists(/databases/$(database)/documents/homecare_conversations/$(assignmentId))
          && homecareConversationMatches(
            assignmentId,
            getAfter(/databases/$(database)/documents/homecare_conversations/$(assignmentId)).data
          )
          && getAfter(/databases/$(database)/documents/homecare_conversations/$(assignmentId)).data.status == 'active';
        allow update, delete: if false;
      }
    }

    // Notifications: owner reads; owner marks read; admin/system may create
    // delivery-failure alerts for admins without permitting arbitrary user spam.
    match /notifications/{id} {
      allow read: if isAdmin() || owns('user_id');
      allow create: if isAdmin()
        || ownsNew('user_id')
        || signedIn()
          && request.resource.data.category == 'delivery'
          && request.resource.data.title == 'Delivery failed'
          && request.resource.data.user_id is string
          && exists(/databases/$(database)/documents/user_roles/$(request.resource.data.user_id + '_admin'))
          && get(/databases/$(database)/documents/user_roles/$(request.resource.data.user_id + '_admin')).data.role == 'admin';
      allow update: if isAdmin() || owns('user_id');
      allow delete: if isAdmin();
    }

    // Document metadata: owner uploads own; admin reviews. Files themselves
    // live in Cloud Storage with matching private rules.
    match /documents/{id} {
      allow read: if isAdmin() || owns('user_id');
      allow create: if ownsNew('user_id');
      allow update: if isAdmin() || owns('user_id');
      allow delete: if isAdmin();
    }

    // Audit logs: admin read only; written by admin actions.
    match /audit_logs/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /wallets/{id} {
      allow read: if isAdmin() || owns('user_id');
      allow write: if false;
    }
    match /wallet_transactions/{id} {
      allow read: if isAdmin() || owns('user_id');
      allow write: if false;
    }
    match /delivery_offers/{id} {
      allow read: if isAdmin() || owns('pharmacy_id')
        || signedIn() && (
          resource.data.target_driver_id == request.auth.uid
          || resource.data.target_driver_id == null && hasRole('driver')
        );
      allow write: if false;
    }
    match /deliveries/{id} {
      allow read: if isAdmin() || owns('driver_id')
        || signedIn() && exists(/databases/$(database)/documents/orders/$(resource.data.order_id))
        && canReadOrder(get(/databases/$(database)/documents/orders/$(resource.data.order_id)).data);
      allow create: if false;
      allow update: if isAdmin() || owns('driver_id');
      allow delete: if isAdmin();
    }
    match /driver_status/{id} {
      allow read: if isAdmin() || owns('driver_id');
      allow create, update: if isAdmin() || ownsNew('driver_id');
      allow delete: if isAdmin() || owns('driver_id');
    }
    match /driver_locations/{id} {
      allow read: if isAdmin() || owns('driver_id');
      allow create, update: if isAdmin() || ownsNew('driver_id');
      allow delete: if isAdmin() || owns('driver_id');
    }
    match /medications/{id} {
      allow read: if isAdmin()
        || owns('pharmacy_id') && hasRole('pharmacy');
      allow create: if isAdmin()
        || hasRole('pharmacy')
          && ownsNew('pharmacy_id')
          && request.resource.data.keys().hasAll([
            'pharmacy_id', 'name', 'price', 'stock_quantity', 'requires_prescription',
            'is_demo', 'is_active', 'publish_requested',
          ])
          && request.resource.data.keys().hasOnly([
            'pharmacy_id', 'name', 'price', 'stock_quantity', 'category',
            'requires_prescription', 'image_url', 'expiry_date', 'batch_number',
            'description', 'is_demo', 'is_active', 'publish_requested',
            'created_at', 'updated_at',
          ])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.price is number
          && request.resource.data.price >= 0
          && request.resource.data.stock_quantity is int
          && request.resource.data.stock_quantity >= 0
          && request.resource.data.requires_prescription is bool
          && request.resource.data.is_demo == false
          && request.resource.data.is_active is bool
          && request.resource.data.publish_requested is bool;
      allow update: if isAdmin()
        || hasRole('pharmacy')
          && owns('pharmacy_id')
          && request.resource.data.pharmacy_id == resource.data.pharmacy_id
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'price', 'stock_quantity', 'category', 'requires_prescription',
            'image_url', 'expiry_date', 'batch_number', 'description', 'is_demo',
            'is_active', 'publish_requested', 'updated_at',
          ])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.price is number
          && request.resource.data.price >= 0
          && request.resource.data.stock_quantity is int
          && request.resource.data.stock_quantity >= 0
          && request.resource.data.requires_prescription is bool
          && request.resource.data.is_demo == false
          && request.resource.data.is_active is bool
          && request.resource.data.publish_requested is bool;
      allow delete: if isAdmin();
    }
    match /pharmacy_offers/{id} {
      allow read: if isAdmin() || owns('pharmacy_id') || owns('patient_id');
      allow create: if isAdmin() || ownsNew('patient_id');
      allow update: if isAdmin() || owns('pharmacy_id');
      allow delete: if isAdmin();
    }
    match /doctor_appointments/{id} {
      allow read: if isAdmin() || owns('patient_id') || owns('doctor_id') || owns('doctor_user_id') || owns('hospital_id');
      // Reservation and paid confirmation are transactional trusted actions.
      allow create: if false;
      allow update: if (
          owns('patient_id') || owns('doctor_id') || owns('doctor_user_id') || owns('hospital_id') || isAdmin()
        ) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelled_at', 'completed_at', 'updated_at', 'doctor_notes'])
        && (
          request.resource.data.status == resource.data.status
          || resource.data.status in ['pending', 'confirmed'] && request.resource.data.status == 'cancelled'
          || (owns('doctor_id') || owns('doctor_user_id') || owns('hospital_id') || isAdmin())
            && resource.data.payment_status == 'paid'
            && resource.data.status == 'confirmed' && request.resource.data.status in ['completed', 'no_show']
        )
        && (!(request.resource.data.diff(resource.data).affectedKeys().hasAny(['doctor_notes', 'completed_at']))
          || owns('doctor_id') || owns('doctor_user_id') || owns('hospital_id') || isAdmin());
      allow delete: if isAdmin();
    }
    match /order_groups/{id} {
      allow read: if isAdmin()
        || owns('patient_id')
        || owns('pharmacy_id') && hasRole('pharmacy')
        || owns('driver_id') && hasRole('driver');
      allow create: if ownsNew('patient_id')
        && isApprovedPharmacy(request.resource.data.pharmacy_id)
        && request.resource.data.keys().hasOnly([
          'patient_id', 'pharmacy_id', 'status', 'delivery_address', 'delivery_lat',
          'delivery_lng', 'pickup_lat', 'pickup_lng', 'delivery_km', 'priority',
          'scheduled_for', 'notes', 'recipient_name', 'recipient_phone',
          'recipient_family_member_id', 'created_at', 'updated_at', 'is_demo',
          'subtotal', 'delivery_fee', 'total_amount', 'assignment_radius_km',
        ])
        && request.resource.data.status in ['pending', 'scheduled']
        && (!('is_demo' in request.resource.data) || request.resource.data.is_demo == false);
      allow update: if isAdmin()
        || owns('patient_id')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hidden_for_patient_at'])
        || owns('pharmacy_id')
          && hasRole('pharmacy')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updated_at'])
          && pharmacyOrderTransition(resource.data.status, request.resource.data.status)
        || owns('driver_id')
          && hasRole('driver')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updated_at'])
          && driverOrderTransition(resource.data.status, request.resource.data.status);
      allow delete: if isAdmin();
    }
    match /order_group_events/{id} {
      allow read: if isAdmin()
        || signedIn() && exists(/databases/$(database)/documents/order_groups/$(resource.data.order_group_id))
        && canReadOrder(get(/databases/$(database)/documents/order_groups/$(resource.data.order_group_id)).data);
      allow create: if isAdmin()
        || signedIn() && exists(/databases/$(database)/documents/order_groups/$(request.resource.data.order_group_id))
        && canReadOrder(get(/databases/$(database)/documents/order_groups/$(request.resource.data.order_group_id)).data);
      allow update, delete: if isAdmin();
    }
    match /appointment_messages/{id} {
      allow read: if isAdmin() || owns('patient_id') || owns('provider_id');
      allow create: if signedIn()
        && request.resource.data.sender_id == request.auth.uid
        && request.resource.data.sender_role in ['patient', 'doctor', 'pharmacy']
        && request.resource.data.appointment_id is string
        && request.resource.data.appointment_type in ['doctor', 'pharmacy']
        && request.resource.data.patient_id is string
        && request.resource.data.provider_id is string
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 2000
        && request.resource.data.created_at is string
        && (
          request.resource.data.appointment_type == 'doctor'
            && exists(/databases/$(database)/documents/doctor_appointments/$(request.resource.data.appointment_id))
            && get(/databases/$(database)/documents/doctor_appointments/$(request.resource.data.appointment_id)).data.patient_id == request.resource.data.patient_id
            && get(/databases/$(database)/documents/doctor_appointments/$(request.resource.data.appointment_id)).data.doctor_id == request.resource.data.provider_id
            && (
              get(/databases/$(database)/documents/doctor_appointments/$(request.resource.data.appointment_id)).data.patient_id == request.auth.uid
              || get(/databases/$(database)/documents/doctor_appointments/$(request.resource.data.appointment_id)).data.doctor_id == request.auth.uid
              || get(/databases/$(database)/documents/doctor_appointments/$(request.resource.data.appointment_id)).data.hospital_id == request.auth.uid
            )
          || request.resource.data.appointment_type == 'pharmacy'
            && exists(/databases/$(database)/documents/pharmacy_appointments/$(request.resource.data.appointment_id))
            && get(/databases/$(database)/documents/pharmacy_appointments/$(request.resource.data.appointment_id)).data.patient_id == request.resource.data.patient_id
            && get(/databases/$(database)/documents/pharmacy_appointments/$(request.resource.data.appointment_id)).data.pharmacy_id == request.resource.data.provider_id
            && (
              get(/databases/$(database)/documents/pharmacy_appointments/$(request.resource.data.appointment_id)).data.patient_id == request.auth.uid
              || get(/databases/$(database)/documents/pharmacy_appointments/$(request.resource.data.appointment_id)).data.pharmacy_id == request.auth.uid
            )
        );
      allow update: if isAdmin() || owns('patient_id') || owns('provider_id');
      allow delete: if isAdmin();
    }
    match /order_messages/{id} {
      allow read: if isAdmin()
        || signedIn()
          && exists(/databases/$(database)/documents/orders/$(resource.data.order_id))
          && canReadOrder(get(/databases/$(database)/documents/orders/$(resource.data.order_id)).data);
      allow create: if signedIn()
        && request.resource.data.sender_id == request.auth.uid
        && request.resource.data.order_id is string
        && request.resource.data.sender_role in ['patient', 'pharmacy', 'driver', 'admin']
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 2000
        && request.resource.data.created_at is string
        && exists(/databases/$(database)/documents/orders/$(request.resource.data.order_id))
        && canReadOrder(get(/databases/$(database)/documents/orders/$(request.resource.data.order_id)).data)
        && request.resource.data.keys().hasOnly(['order_id', 'sender_id', 'sender_role', 'body', 'created_at']);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    match /prescriptions/{id} {
      allow read: if isAdmin() || owns('patient_id') || owns('doctor_id') || owns('pharmacy_id');
      allow create: if isAdmin() || ownsNew('patient_id') || ownsNew('doctor_id');
      allow update: if isAdmin() || owns('patient_id') || owns('doctor_id') || owns('pharmacy_id');
      allow delete: if isAdmin();
    }
    match /e_prescriptions/{id} {
      allow read: if isAdmin() || owns('patient_id') || owns('doctor_id') || owns('hospital_id');
      allow create: if isAdmin() || ownsNew('doctor_id') || ownsNew('hospital_id');
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    match /prescription_uploads/{id} {
      allow read: if isAdmin()
        || owns('patient_id')
        || pharmacyMayHandlePrescription();
      allow create: if ownsNew('patient_id')
        && request.resource.data.pharmacy_id == null
        && request.resource.data.status == 'pending';
      allow update: if isAdmin()
        || owns('patient_id')
          && request.resource.data.patient_id == resource.data.patient_id
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'pharmacy_id', 'order_id', 'updated_at',
          ])
          && request.resource.data.status == resource.data.status
          && request.resource.data.order_id is string
          && exists(/databases/$(database)/documents/orders/$(request.resource.data.order_id))
          && get(/databases/$(database)/documents/orders/$(request.resource.data.order_id)).data.patient_id == request.auth.uid
          && get(/databases/$(database)/documents/orders/$(request.resource.data.order_id)).data.pharmacy_id == request.resource.data.pharmacy_id
          && (!('medication_id' in resource.data)
            || resource.data.medication_id == get(/databases/$(database)/documents/orders/$(request.resource.data.order_id)).data.medication_id)
        || pharmacyMayHandlePrescription()
          && request.resource.data.patient_id == resource.data.patient_id
          && request.resource.data.pharmacy_id == resource.data.pharmacy_id
          && (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['flagged', 'updated_at'])
            && request.resource.data.status == resource.data.status
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'pharmacist_notes', 'reviewed_by', 'repeats_total', 'updated_at',
            ])
              && request.resource.data.reviewed_by == request.auth.uid
              && (
                request.resource.data.status == resource.data.status
                || resource.data.status in ['pending', 'reupload_requested']
                  && request.resource.data.status in ['approved', 'rejected', 'reupload_requested']
              )
          );
      allow delete: if isAdmin() || owns('patient_id');
    }
    match /driver_documents/{id} {
      allow read: if isAdmin() || owns('driver_id');
      allow create: if isAdmin() || ownsNew('driver_id');
      allow update: if isAdmin() || owns('driver_id')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'id_document_path', 'license_path', 'selfie_path', 'vehicle_photo_path',
          'vehicle_registration', 'vehicle_type', 'submitted_at', 'updated_at',
        ]);
      allow delete: if isAdmin();
    }
    match /doctor_documents/{id} {
      allow read: if isAdmin() || owns('doctor_id') || owns('doctor_user_id');
      allow create: if isAdmin() || ownsNew('doctor_id') || ownsNew('doctor_user_id');
      allow update: if isAdmin()
        || owns('doctor_id') && request.resource.data.doctor_id == resource.data.doctor_id
        || owns('doctor_user_id') && request.resource.data.doctor_user_id == resource.data.doctor_user_id;
      allow delete: if isAdmin();
    }
    match /doctor_availability/{id} {
      allow read: if signedIn();
      allow create: if isAdmin() || ownsNew('doctor_id') || ownsNew('doctor_user_id')
        || signedIn() && exists(/databases/$(database)/documents/doctors/$(request.resource.data.doctor_id))
          && get(/databases/$(database)/documents/doctors/$(request.resource.data.doctor_id)).data.user_id == request.auth.uid;
      allow update, delete: if isAdmin() || owns('doctor_id') || owns('doctor_user_id')
        || signedIn() && exists(/databases/$(database)/documents/doctors/$(resource.data.doctor_id))
          && get(/databases/$(database)/documents/doctors/$(resource.data.doctor_id)).data.user_id == request.auth.uid;
    }
    match /doctor_reviews/{id} {
      allow read: if signedIn();
      allow create: if ownsNew('patient_id');
      allow update: if isAdmin() || owns('patient_id');
      allow delete: if isAdmin();
    }
    // Patient-saved preferred doctors and caregivers. Doc id: {uid}_{type}_{providerId}.
    match /patient_favourites/{id} {
      allow read, delete: if owns('patient_id');
      allow create, update: if ownsNew('patient_id')
        && id == request.auth.uid + '_' + request.resource.data.provider_type + '_' + request.resource.data.provider_id
        && request.resource.data.provider_type in ['doctor', 'caregiver']
        && request.resource.data.keys().hasOnly(['patient_id', 'provider_type', 'provider_id', 'provider_name', 'created_at']);
    }
    match /complaints/{id} {
      allow read: if isAdmin() || owns('user_id') || owns('patient_id');
      allow create: if ownsNew('user_id') || ownsNew('patient_id');
      allow update, delete: if isAdmin();
    }
    match /homecare_documents/{id} {
      allow read: if isAdmin() || owns('provider_id') || owns('user_id');
      allow create: if isAdmin() || ownsNew('provider_id') || ownsNew('user_id');
      allow update: if isAdmin()
        || (owns('provider_id') && request.resource.data.provider_id == resource.data.provider_id)
        || (owns('user_id') && request.resource.data.user_id == resource.data.user_id);
      allow delete: if isAdmin();
    }
    match /pharmacy_documents/{id} {
      allow read: if isAdmin() || owns('pharmacy_id');
      allow create: if isAdmin() || ownsNew('pharmacy_id');
      allow update: if isAdmin() || owns('pharmacy_id')
        && request.resource.data.pharmacy_id == resource.data.pharmacy_id;
      allow delete: if isAdmin();
    }
    match /pharmacy_branches/{id} {
      allow read: if isAdmin()
        || owns('pharmacy_id') && hasRole('pharmacy')
        || signedIn() && resource.data.is_primary == true && resource.data.is_active == true;
      allow create: if isAdmin() || hasRole('pharmacy') && ownsNew('pharmacy_id');
      allow update: if isAdmin() || hasRole('pharmacy')
        && owns('pharmacy_id')
        && request.resource.data.pharmacy_id == resource.data.pharmacy_id;
      allow delete: if isAdmin() || hasRole('pharmacy') && owns('pharmacy_id');
    }
    match /pharmacy_appointments/{id} {
      allow read: if isAdmin() || owns('patient_id') || owns('pharmacy_id');
      allow create: if ownsNew('patient_id');
      allow update: if isAdmin() || owns('patient_id') || owns('pharmacy_id');
      allow delete: if isAdmin();
    }
    match /driver_bank_accounts/{id} {
      allow read, update, delete: if isAdmin() || owns('driver_id');
      allow create: if isAdmin() || ownsNew('driver_id');
    }
    match /driver_payouts/{id} {
      allow read: if isAdmin() || owns('driver_id');
      allow write: if isAdmin();
    }
    match /family_members/{id} {
      allow read, update, delete: if isAdmin() || owns('patient_id');
      allow create: if isAdmin() || ownsNew('patient_id');
    }
    match /ratings/{id} {
      allow read: if isAdmin() || owns('patient_id') || owns('provider_id');
      allow create: if ownsNew('patient_id');
      allow update: if isAdmin() || owns('patient_id');
      allow delete: if isAdmin();
    }
    match /medications_public/{id} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /pharmacy_directory/{id} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /admin_audit_log/{id} {
      allow read, write: if isAdmin();
    }
    match /admin_invites/{id} {
      allow read, write: if isAdmin();
    }
    match /homecare_approval_events/{id} {
      allow read, write: if isAdmin();
    }
    match /prescription_audit_log/{id} {
      allow read: if isAdmin() || owns('patient_id') || owns('doctor_id');
      allow write: if isAdmin();
    }
    match /{collection}/{id} {
      allow read, update, delete: if collection in [
        'user_addresses', 'notification_preferences', 'medication_reminders',
        'card_pins', 'saved_payment_methods',
      ] && (isAdmin() || owns('user_id'));
      allow create: if collection in [
        'user_addresses', 'notification_preferences', 'medication_reminders',
        'card_pins', 'saved_payment_methods',
      ] && (isAdmin() || ownsNew('user_id'));
    }

    // Default deny everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
